# ---- LLM (required for live mode) -------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# JSON list; ordered fallback chain. Verified free + tool-calling capable.
MODEL_FALLBACK_CHAIN=["inclusionai/ling-3.0-flash:free","google/gemma-4-31b-it:free","openai/gpt-oss-20b:free"]
LLM_TIMEOUT_S=25
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
LLM_TEMPERATURE=0.2

# ---- Cache -------------------------------------------------------------------
CACHE_BACKEND=memory
PROFILE_TTL_S=86400
QUERY_HISTORY_TTL_S=604800
QUERY_HISTORY_MAX_N=5
VIZ_STATE_TTL_S=3600

# ---- Guardrails --------------------------------------------------------------
MAX_PROMPT_CHARS=2000
TOKEN_BUDGET_INPUT=6000
TOKEN_BUDGET_OUTPUT=800
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_S=60

# ---- Storage / time ----------------------------------------------------------
CHART_OUTPUT_DIR=./output
# Anchor for relative dates ("last month"). Defaults to max(transaction_date).
# AS_OF_DATE=2025-12-31

# ==============================================================================
# PRODUCTION / MULTI-TENANT
# ==============================================================================
# Everything above runs the single-file assessment deployment. The settings
# below switch on the multi-tenant path: transactions in Postgres, identity from
# signed tokens, one client's data per query instead of the whole corpus in RAM.

# ---- Persistence -------------------------------------------------------------
# "dataframe" = the original single-file mode. "sql" = multi-tenant.
STORAGE_BACKEND=dataframe
# DATABASE_URL=postgresql+psycopg://ledger:secret@localhost:5432/ledger
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Keep DB_POOL_SIZE * worker_count below the server's max_connections.
INGEST_CHUNK_SIZE=5000
INGEST_MAX_ROWS=2000000

# ---- Auth --------------------------------------------------------------------
# MUST be true for any deployment holding real client data. With it false,
# `user_id` is taken from the request and anyone can read anyone.
AUTH_REQUIRED=false
# At least 32 chars for HS256; the process refuses to start below that.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_ALGORITHM=HS256
# For RS256/ES256, supply the PEM public key instead of a secret:
# JWT_PUBLIC_KEY=
# JWT_ISSUER=https://id.example.com
# JWT_AUDIENCE=transaction-rag
JWT_LEEWAY_S=30
JWT_DEFAULT_TTL_S=3600
# How long a chart URL stays valid.
CHART_TOKEN_TTL_S=3600

# ---- Multi-tenancy -----------------------------------------------------------
TENANT_CACHE_SIZE=256
TENANT_CACHE_TTL_S=900
DEFAULT_TENANT_ID=default

# ---- Time --------------------------------------------------------------------
# "data_max" anchors "last month" to the newest row -- right for a frozen
# historical upload. "now" anchors to wall-clock -- right for live client data.
# Per-tenant overrides live in the `tenants` table.
AS_OF_MODE=data_max

# --- Groq (optional second provider) ---
# Same OpenAI chat-completions wire format as OpenRouter. With both set and
# LLM_PROVIDER=auto, Groq is tried first (faster, separate free-tier quota) and
# OpenRouter is the breadth fallback.
GROQ_API_KEY=
# LLM_PROVIDER=auto        # auto | groq | openrouter
# GROQ_MODEL_CHAIN=["llama-3.3-70b-versatile","llama-3.1-8b-instant"]
