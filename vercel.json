{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{src/**,api.py,demo.py,assessment_transaction_data.xlsx}",
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(query|users|auth|ingest|requests|charts|healthz|readyz|metrics)(/.*)?",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1",
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
